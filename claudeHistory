def tui(stdscr, load):
    import curses
    curses.curs_set(0)
    curses.use_default_colors()
    for i, col in enumerate([curses.COLOR_CYAN, curses.COLOR_MAGENTA, curses.COLOR_YELLOW,
                             curses.COLOR_GREEN, curses.COLOR_BLUE], 1):
        curses.init_pair(i, col, -1)
    home = os.path.expanduser("~")
    query, sel, top = "", 0, 0
    sessions, status = load(), ""

    def put(y, x, s, attr=0, w=None):
        h, W = stdscr.getmaxyx()
        if 0 <= y < h and x < W:
            try:
                stdscr.addnstr(y, x, s, (w or W - x), attr)
            except curses.error:
                pass

    def ask(label, default=""):
        """Saisie d'une ligne en bas de l'écran. Échap = annuler (None)."""
        text = default
        curses.curs_set(1)
        try:
            while True:
                h, W = stdscr.getmaxyx()
                put(h - 1, 0, " " * (W - 1), 0, W - 1)
                put(h - 1, 0, f" {label} {text}", curses.color_pair(3) | curses.A_BOLD, W - 1)
                stdscr.refresh()
                k = stdscr.get_wch()
                if k in ("\n", "\r", curses.KEY_ENTER):
                    return text.strip()
                if k == "\x1b":
                    return None
                if k in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                    text = text[:-1]
                elif isinstance(k, str) and k.isprintable():
                    text += k
        finally:
            curses.curs_set(0)

    def run(label, fn):
        nonlocal status
        h, W = stdscr.getmaxyx()
        put(h - 1, 0, f" {label}…".ljust(W - 1), curses.color_pair(3) | curses.A_BOLD, W - 1)
        stdscr.refresh()
        try:
            status = fn()
        except Exception as e:
            status = f"✗ Erreur : {e}"

    def help_screen():
        h, W = stdscr.getmaxyx()
        bw = min(W - 2, 60)
        x, y0 = max(0, (W - bw) // 2), max(0, (h - len(KEYS) - 4) // 2)
        for i in range(len(KEYS) + 4):
            put(y0 + i, x, " " * bw, curses.A_REVERSE, bw)
        put(y0 + 1, x + 2, "Raccourcis — une touche pour fermer", curses.A_REVERSE | curses.A_BOLD, bw - 4)
        for i, (key, label) in enumerate(KEYS):
            put(y0 + 3 + i, x + 2, f"{key:<17} {label}", curses.A_REVERSE, bw - 4)
        stdscr.refresh()
        stdscr.get_wch()

    def view(s):
        """Lecture plein écran de la conversation."""
        h, W = stdscr.getmaxyx()
        lines = []
        for hm, who, text in conversation(s):
            lines.append((f"[{hm}] {who} :", curses.color_pair(3 if who == "Toi" else 4) | curses.A_BOLD))
            lines += [(l, 0) for l in wrap(text, max(10, W - 4))] + [("", 0)]
        pos = 0
        while True:
            h, W = stdscr.getmaxyx()
            rows = h - 2
            pos = max(0, min(pos, len(lines) - rows))
            stdscr.erase()
            put(0, 0, f" {s['title'] or '(sans titre)'}  ({s['id'][:8]})", curses.color_pair(1) | curses.A_BOLD)
            for i, (text, attr) in enumerate(lines[pos:pos + rows]):
                put(i + 1, 2, text, attr, W - 3)
            put(h - 1, 0, f" {min(pos + rows, len(lines))}/{len(lines)} · ↑↓ PgPréc PgSuiv Début Fin · Échap revenir"
                .ljust(W - 1), curses.A_REVERSE, W - 1)
            stdscr.refresh()
            k = stdscr.get_wch()
            if k in ("\x1b", "q", curses.KEY_F10):
                return
            pos += {curses.KEY_UP: -1, curses.KEY_DOWN: 1, curses.KEY_PPAGE: -rows, curses.KEY_NPAGE: rows,
                    curses.KEY_HOME: -len(lines), curses.KEY_END: len(lines)}.get(k, 0)

    while True:
        q = query.lower()
        items = [s for s in sessions if not q or q in (s["title"] or "").lower()
                 or q in s["cwd"].lower() or any(q in p.lower() for p in s["prompts"])]
        sel = max(0, min(sel, len(items) - 1))
        h, W = stdscr.getmaxyx()
        lw = max(30, W * 45 // 100)
        rows = h - 4
        top = min(max(top, sel - rows + 1), sel) if items else 0
        stdscr.erase()
        put(0, 0, " Sessions Claude", curses.A_BOLD)
        put(0, 18, f"({len(items)}/{len(sessions)})  ↑↓ naviguer · Entrée reprendre · tape pour filtrer · Échap quitter",
            curses.A_DIM)
        put(1, 0, f" / {query}", curses.color_pair(3) | curses.A_BOLD)
        for i, s in enumerate(items[top:top + rows]):
            y, cur = i + 2, top + i == sel
            base = curses.A_REVERSE if cur else 0
            put(y, 0, " " * lw, base, lw)
            put(y, 1, f"{s['end']:%m-%d %H:%M}", base | curses.A_DIM, lw - 1)
            folder = os.path.basename(s["cwd"].rstrip("/\\")) or "/"
            folder = "~" if s["cwd"].rstrip("/\\") == home else one_line(folder, max(4, (lw - 14) // 3))
            title = one_line(s["title"] or "(sans titre)", max(1, lw - 16 - len(folder)))
            put(y, 13, title, base | curses.A_BOLD, lw - 13)
            put(y, lw - len(folder) - 1, folder, base | curses.color_pair(2), len(folder))
        for y in range(1, h):
            put(y, lw, "│", curses.A_DIM, 1)
        if items:
            s, x, pw = items[sel], lw + 2, W - lw - 3
            put(1, x, s["title"] or "(sans titre)", curses.color_pair(1) | curses.A_BOLD, pw)
            put(3, x, "Dossier : ", curses.A_DIM, pw)
            put(3, x + 10, s["cwd"].replace(home, "~", 1), curses.color_pair(2) | curses.A_BOLD, pw - 10)
            if not os.path.isdir(s["cwd"]):
                put(4, x, "⚠ dossier introuvable", curses.color_pair(3), pw)
            put(5, x, f"Branche : {s['branch'] or '-'}", curses.A_DIM, pw)
            put(6, x, f"Période : {s['start']:%Y-%m-%d %H:%M} → {s['end']:%Y-%m-%d %H:%M}", curses.A_DIM, pw)
            put(7, x, f"Prompts : {len(s['prompts'])}    id : {s['id'][:8]}", curses.A_DIM, pw)
            put(9, x, "Dernier prompt :", curses.color_pair(3) | curses.A_BOLD, pw)
            y = 10
            for line in wrap(s["prompts"][-1] if s["prompts"] else "", pw)[: max(0, h - 13)]:
                put(y, x, line, 0, pw); y += 1
            if s["replies"] and y < h - 3:
                put(y + 1, x, "Dernière réponse :", curses.color_pair(4) | curses.A_BOLD, pw)
                for line in wrap(s["replies"][-1], pw)[: max(0, h - y - 3)]:
                    put(y + 2, x, line, curses.A_DIM, pw); y += 1
        put(h - 1, 0, " " * (W - 1), curses.A_REVERSE, W - 1)
        put(h - 1, 0, status or FOOTER,
            curses.A_REVERSE | (curses.A_BOLD if status else 0), W - 1)
        stdscr.refresh()

        k = stdscr.get_wch()
        if k != curses.KEY_RESIZE:
            status = ""
        if k in (curses.KEY_F2, curses.KEY_F3, curses.KEY_F5) and (items or k == curses.KEY_F5):
            chosen = {curses.KEY_F2: items[sel:sel + 1], curses.KEY_F3: items}.get(k) or [
                s for s in all_sessions()]
            default = os.path.expanduser(f"~/claude-history-{datetime.now():%Y%m%d-%H%M%S}.tar.gz")
            dest = ask(f"Exporter {len(chosen)} session(s) vers :", default)
            if dest:
                run("Export en cours", lambda: "✓ {1} session(s) exportée(s) → {0}".format(
                    *export_history(chosen, os.path.expanduser(dest))))
            continue
        if k == curses.KEY_F6:
            src = ask("Importer l'archive :", latest_export())
            if src:
                def do_import():
                    nonlocal sessions
                    n, skip = import_history(src)
                    sessions = load()
                    return f"✓ {n} session(s) importée(s), {skip} déjà présente(s)"
                run("Import en cours", do_import)
            continue
        if k == curses.KEY_F8 and items:
            s = items[sel]
            ans = ask(f"Supprimer définitivement « {one_line(s['title'] or '(sans titre)', 40)} » ({s['id'][:8]}) ? o/N :")
            if ans and ans.lower() in ("o", "oui", "y", "yes"):
                def do_delete():
                    nonlocal sessions
                    delete_session(s)
                    sessions = load()
                    return f"✓ Session {s['id'][:8]} supprimée"
                run("Suppression", do_delete)
            continue
        if k == curses.KEY_F1:
            help_screen()
            continue
        if k == curses.KEY_F10 and items:
            view(items[sel])
            continue
        if k == curses.KEY_F7 and items:
            s = items[sel]
            title = ask("Nouveau titre :", s["title"] or "")
            if title:
                def do_rename():
                    nonlocal sessions
                    rename_session(s, title)
                    sessions = load()
                    return f"✓ Session renommée : {title}"
                run("Renommage", do_rename)
            continue
        if k == curses.KEY_F4 and items:
            cwd = items[sel]["cwd"]
            if os.path.isdir(cwd):
                run("Ouverture", lambda: open_folder(cwd) or f"✓ Dossier ouvert : {cwd}")
            else:
                status = f"⚠ Dossier introuvable : {cwd}"
            continue
        if k == curses.KEY_F12 and items:
            line = resume_line(items[sel])
            run("Copie", lambda: f"✓ Copié : {line}" if copy_to_clipboard(line)
                else "✗ Aucun outil de presse-papiers (clip, pbcopy, wl-copy, xclip, xsel)")
            continue
        if k == curses.KEY_F9 and items:
            return items[sel], True
        if k in (curses.KEY_UP,):
            sel -= 1
        elif k in (curses.KEY_DOWN,):
            sel += 1
        elif k == curses.KEY_PPAGE:
            sel -= rows
        elif k == curses.KEY_NPAGE:
            sel += rows
        elif k == curses.KEY_HOME:
            sel = 0
        elif k == curses.KEY_END:
            sel = len(items) - 1
        elif k in ("\n", "\r", curses.KEY_ENTER):
            if items:
                return items[sel], False
        elif k == "\x1b":
            if not query:
                return None
            query, sel = "", 0
        elif k in (curses.KEY_BACKSPACE, "\x7f", "\b"):
            query, sel = query[:-1], 0
        elif k == curses.KEY_RESIZE:
            pass
        elif isinstance(k, str) and k.isprintable():
            query, sel = query + k, 0


def select():
    import locale
    try:
        import curses
    except ImportError:
        sys.exit("Le sélecteur interactif nécessite curses : py -m pip install --user windows-curses"
                 if WIN else "Le sélecteur interactif nécessite le module curses de Python.")
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    load = lambda: sorted((s for s in all_sessions() if s["prompts"]), key=lambda s: s["end"], reverse=True)
    picked = curses.wrapper(tui, load)
    if not picked:
        return
    launch(*picked)


def launch(s, fork=False):
    """Se place dans le dossier de la session et y reprend la session avec claude."""
    if not os.path.isdir(s["cwd"]):
        sys.exit(f"Le dossier {s['cwd']} n'existe plus.")
    args = ["-r", s["id"]] + (["--fork-session"] if fork else [])
    print(c("1;34", "↻ " + resume_line(s) + (" --fork-session" if fork else "")))
    os.chdir(s["cwd"])
    if WIN:
        # Pas de vrai exec sous Windows (la console serait partagée) : on lance claude et on attend.
        exe = shutil.which("claude")
        if not exe:
            sys.exit("claude introuvable dans le PATH.")
        sys.exit(subprocess.call([exe] + args))
    os.execvp("claude", ["claude"] + args)


def main():
    prog = os.path.splitext(os.path.basename(sys.argv[0]))[0]
    alias = {"exportClaudeHistory": "export", "importClaudeHistory": "import"}.get(prog)
    if alias:
        sys.argv.insert(1, alias)
    if prog == "selectSessions" or sys.argv[1:2] == ["select"] \
            or (len(sys.argv) == 1 and sys.stdin.isatty() and sys.stdout.isatty()):
        select()
        return
    if sys.argv[1:2] in (["export"], ["import"]) and len(sys.argv) > 2 and sys.argv[2].startswith("-"):
        print(__doc__)
        return
    if sys.argv[1:2] == ["export"]:
        print("Export de toutes les sessions…", file=sys.stderr)
        dest, n = export_history(all_sessions(),
                                 os.path.expanduser(sys.argv[2]) if len(sys.argv) > 2 else None)
        print(f"✓ {n} session(s) exportée(s) → {dest}")
        return
    if sys.argv[1:2] == ["import"]:
        src = sys.argv[2] if len(sys.argv) > 2 else latest_export()
        if not src:
            sys.exit("Usage : importClaudeHistory <archive.tar.gz>  (aucune archive claude-history-*.tar.gz trouvée)")
        if not os.path.isfile(os.path.expanduser(src)):
            sys.exit(f"Archive introuvable : {src}")
        print(f"Import de {src}…", file=sys.stderr)
        n, skip = import_history(src)
        print(f"✓ {n} session(s) importée(s), {skip} déjà présente(s)")
        return
    if sys.argv[1:2] == ["delete"]:
        args = [x for x in sys.argv[2:] if x not in ("-y", "--yes")]
        if len(args) != 1:
            sys.exit("Usage : claudeHistory delete <id> [--yes]")
        s = find_session(all_sessions(), args[0])
        header(s, os.path.expanduser("~"))
        if len(args) == len(sys.argv[2:]):  # pas de --yes
            if not sys.stdin.isatty():
                sys.exit("Confirmation requise : relancer avec --yes")
            try:  # sous Windows, NUL passe pour un terminal : EOF = annulation
                ans = input("Supprimer définitivement cette session ? [o/N] ")
            except EOFError:
                ans = ""
            if ans.strip().lower() not in ("o", "oui", "y", "yes"):
                print("Annulé.")
                return
        delete_session(s)
        print(f"✓ Session {s['id']} supprimée")
        return
    if sys.argv[1:2] == ["resume"]:
        args = [x for x in sys.argv[2:] if not x.startswith("--")]
        if len(args) != 1:
            sys.exit("Usage : claudeHistory resume <n°|id> [--fork] [--window] [--copy]")
        s, fork = find_session(all_sessions(), args[0]), "--fork" in sys.argv
        if "--window" in sys.argv:
            if not os.path.isdir(s["cwd"]):
                sys.exit(f"Le dossier {s['cwd']} n'existe plus.")
            try:
                term = open_terminal(s["cwd"], ["-r", s["id"]] + (["--fork-session"] if fork else []))
            except Exception:
                term = None
            if term:
                header(s, os.path.expanduser("~"))
                print(f"✓ Ouverte dans une nouvelle fenêtre ({term}) : {resume_line(s)}"
                      + (" --fork-session" if fork else ""))
                return
            print("✗ Impossible d'ouvrir une fenêtre de terminal : commande copiée à la place.")
            sys.argv.append("--copy")
        elif sys.stdin.isatty() and sys.stdout.isatty() and "--copy" not in sys.argv:
            launch(s, fork)
            return
        # Depuis Claude Code (pas de terminal) : on donne la commande exacte, avec l'id complet.
        here = os.path.normcase(os.path.abspath(os.getcwd())) == os.path.normcase(os.path.abspath(s["cwd"]))
        fork_opt = " --fork-session" if fork else ""
        cmd = f"/resume {s['id']}" if here and not fork else resume_line(s) + fork_opt
        header(s, os.path.expanduser("~"))
        print(f"Dans cette fenêtre Claude : /resume {s['id']}" if here else
              "Autre dossier : à lancer dans un nouveau terminal")
        print(f"Terminal : {resume_line(s)}{fork_opt}")
        if "--copy" in sys.argv:
            try:
                ok = copy_to_clipboard(cmd)
            except Exception:
                ok = False
            print(f"✓ Copié dans le presse-papiers : {cmd}" if ok else "✗ Copie impossible (aucun outil de presse-papiers)")
        return
    if sys.argv[1:2] == ["rename"]:
        if len(sys.argv) < 4:
            sys.exit("Usage : claudeHistory rename <id> <nouveau titre>")
        s, title = find_session(all_sessions(), sys.argv[2]), " ".join(sys.argv[3:]).strip()
        rename_session(s, title)
        print(f"✓ Session {s['id']} renommée : {title}")
        return
    if sys.argv[1:2] == ["list"]:
        del sys.argv[1]
    if len(sys.argv) > 1 and sys.argv[1] == "search":
        if len(sys.argv) < 3:
            sys.exit("Usage : claudeHistory search <mot clé>")
        search([s for s in all_sessions() if s["prompts"]], sys.argv[2:])
        return
    ap = argparse.ArgumentParser(description="Historique de toutes les sessions Claude Code du PC")
    ap.add_argument("-n", type=int, help="nombre de sessions (les plus récentes)")
    ap.add_argument("-g", "--grep", help="filtre texte (titre, projet, prompts)")
    ap.add_argument("-p", "--project", help="filtre sur le chemin du projet")
    ap.add_argument("-s", "--show", metavar="ID", help="affiche la conversation d'une session")
    ap.add_argument("-f", "--full", action="store_true", help="avec -s : réponses complètes")
    ap.add_argument("-a", "--all", action="store_true", help="inclut les sessions sans prompt")
    ap.add_argument("--json", action="store_true", help="sortie JSON")
    a = ap.parse_args()

    sessions = list(all_sessions())

    if a.show:
        show(find_session(sessions, a.show), a.full)
        return

    if not a.all:
        sessions = [s for s in sessions if s["prompts"]]
    if a.project:
        sessions = [s for s in sessions if a.project.lower() in s["cwd"].lower()]
    if a.grep:
        g = a.grep.lower()
        sessions = [s for s in sessions
                    if g in (s["title"] or "").lower() or g in s["cwd"].lower()
                    or any(g in p.lower() for p in s["prompts"])]
    sessions.sort(key=lambda s: s["end"])
    if a.n:
        sessions = sessions[-a.n:]

    nums = number(sessions)
    if a.json:
        print(json.dumps([{"n": nums[s["id"]], "id": s["id"], "title": s["title"], "project": s["cwd"],
                           "branch": s["branch"], "start": s["start"].isoformat(), "end": s["end"].isoformat(),
                           "prompts": s["prompts"]} for s in sessions], ensure_ascii=False, indent=2))
        return

    home = os.path.expanduser("~")
    for s in sessions:
        header(s, home, nums[s["id"]])
        if s["prompts"]:
            print("    ↳", one_line(s["prompts"][0], 90))
        print("    " + c("34", "↻ " + resume_line(s)))
    print(c("2", f"\n{len(sessions)} session(s) — détail : claudeHistory -s <n°|id>"
                 " · reprendre : claudeHistory resume <n°|id>"))


if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):
        pass
