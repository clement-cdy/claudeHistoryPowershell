#!/usr/bin/env python3
"""claudeHistory — liste toutes les sessions Claude Code du PC.

Usage :
  claudeHistory                 sélecteur interactif (TUI) : Entrée = reprendre la session
  claudeHistory select          idem (alias : selectSessions)
  exportClaudeHistory [fichier] alias de « claudeHistory export »
  importClaudeHistory [fichier] alias de « claudeHistory import » (sans argument : dernière archive trouvée)
  claudeHistory export [fichier] exporte toutes les sessions dans une archive .tar.gz
  claudeHistory import <fichier> importe une archive (sessions déjà présentes ignorées)
  claudeHistory list            liste toutes les sessions (plus récentes en bas)
  claudeHistory -n 20           seulement les 20 dernières
  claudeHistory search motclé   cherche dans tout le contenu des sessions (toi + Claude)
  claudeHistory -g motclé       filtre (titre, projet, prompts de la session)
  claudeHistory -p tiktok       filtre sur le dossier projet
  claudeHistory -s <id>         affiche la conversation d'une session (id partiel accepté)
  claudeHistory -s <id> -f      idem avec les réponses complètes de Claude
  claudeHistory delete <id>     supprime une session (confirmation demandée ; --yes pour s'en passer)
  claudeHistory rename <id> <titre>  renomme une session (comme /rename)
  claudeHistory resume <n°|id>  reprend une session (--fork : sur une copie ; --window : dans une nouvelle
                                fenêtre de terminal ; --copy : copie la commande)

  <id> accepte un début d'id, ou le n° [3] affiché par la dernière liste / recherche.
  claudeHistory -a              inclut les sessions vides (sans prompt)
  claudeHistory --json          sortie JSON
"""
import argparse, glob, io, json, os, re, shutil, subprocess, sys
from datetime import datetime

WIN = os.name == "nt"
if WIN:
    # Sortie redirigée (pipe, Claude Code…) : la console Windows n'est pas en UTF-8 par défaut.
    for _stream in (sys.stdout, sys.stderr):
        try:
            _stream.reconfigure(encoding="utf-8", errors="replace")
        except Exception:
            pass

ROOTS = sorted(set(
    glob.glob(os.path.expanduser("~/.claude*/projects"))
    + glob.glob("/home/*/.claude*/projects")
    + glob.glob("/root/.claude*/projects")
    + ([os.path.join(os.environ["CLAUDE_CONFIG_DIR"], "projects")] if os.environ.get("CLAUDE_CONFIG_DIR") else [])
))

TTY = sys.stdout.isatty()
if TTY and WIN:
    # Active les séquences ANSI (couleurs) dans la console Windows.
    try:
        import ctypes
        _k = ctypes.windll.kernel32
        _h, _m = _k.GetStdHandle(-11), ctypes.c_uint32()
        if _k.GetConsoleMode(_h, ctypes.byref(_m)):
            _k.SetConsoleMode(_h, _m.value | 0x0004)
    except Exception:
        pass
def c(code, s): return f"\033[{code}m{s}\033[0m" if TTY else s


def prompt_text(d):
    """Texte d'un vrai prompt utilisateur, sinon None (tool_result, méta, commandes internes)."""
    if d.get("type") != "user" or d.get("isMeta") or d.get("isSidechain"):
        return None
    content = (d.get("message") or {}).get("content")
    if isinstance(content, list):
        parts = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]
        if not parts:
            return None
        content = "\n".join(parts)
    if not isinstance(content, str):
        return None
    t = content.strip()
    if not t or t.startswith(("<local-command", "<command-message", "<system-reminder", "Caveat:")):
        return None
    if t.startswith("<command-name>"):
        t = t.split("</command-name>")[0].replace("<command-name>", "").strip()
    return t


def assistant_text(d):
    content = (d.get("message") or {}).get("content")
    if isinstance(content, list):
        return "\n".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text").strip()
    return content.strip() if isinstance(content, str) else ""


def ts(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).astimezone()
    except Exception:
        return None


def load_session(path):
    s = {"id": os.path.basename(path)[:-6], "file": path, "title": None, "cwd": None,
         "start": None, "end": None, "prompts": [], "replies": [], "branch": None}
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                d = json.loads(line)
            except Exception:
                continue
            t = d.get("type")
            if t == "ai-title":
                s["title"] = d.get("aiTitle") or s["title"]
            elif t == "custom-title":
                s["title"] = d.get("customTitle") or s["title"]
            elif t == "agent-name" and not s["title"]:
                s["title"] = d.get("agentName")
            if d.get("cwd") and not s["cwd"]:
                s["cwd"] = d["cwd"]
            if d.get("gitBranch") and not s["branch"]:
                s["branch"] = d["gitBranch"]
            when = ts(d["timestamp"]) if isinstance(d.get("timestamp"), str) else None
            if when:
                s["start"] = s["start"] or when
                s["end"] = when
            p = prompt_text(d)
            if p:
                s["prompts"].append(p)
            elif t == "assistant" and not d.get("isSidechain"):
                a = assistant_text(d)
                if a:
                    s["replies"].append(a)
    if not s["cwd"]:
        s["cwd"] = decode_dir(os.path.basename(os.path.dirname(path)))
    if not s["end"]:
        s["end"] = s["start"] = datetime.fromtimestamp(os.path.getmtime(path)).astimezone()
    return s


CACHE = os.path.expanduser("~/.cache/claudeHistory/index.json")
LAST = os.path.expanduser("~/.cache/claudeHistory/last.json")  # n° → id de la dernière liste affichée


def all_sessions():
    """Sessions parsées, avec un cache par fichier (invalidé si taille/mtime changent)."""
    try:
        with open(CACHE, encoding="utf-8") as fh:
            cache = json.load(fh)
    except Exception:
        cache = {}
    fresh, out = {}, []
    for root in ROOTS:
        for path in glob.glob(os.path.join(glob.escape(root), "*", "*.jsonl")):
            try:
                st = os.stat(path)
                key = f"{st.st_size}:{st.st_mtime_ns}"
                hit = cache.get(path)
                if hit and hit["key"] == key:
                    s = hit["s"]
                else:
                    s = load_session(path)
                    s["start"], s["end"] = s["start"].isoformat(), s["end"].isoformat()
                fresh[path] = {"key": key, "s": s}
                s = dict(s, start=datetime.fromisoformat(s["start"]), end=datetime.fromisoformat(s["end"]))
                out.append(s)
            except OSError:
                continue
    if fresh != cache:
        try:
            os.makedirs(os.path.dirname(CACHE), exist_ok=True)
            with open(CACHE + ".tmp", "w", encoding="utf-8") as fh:
                json.dump(fresh, fh, ensure_ascii=False)
            os.replace(CACHE + ".tmp", CACHE)
        except OSError:
            pass
    return out


def one_line(t, n):
    t = " ".join(t.split())
    return t if len(t) <= n else t[: n - 1] + "…"


def resume_line(s):
    if WIN:  # syntaxe PowerShell (5.1 n'a pas « && »)
        return "cd '{}'; claude -r {}".format(s["cwd"].replace("'", "''"), s["id"])
    return f"cd {s['cwd']!r} && claude -r {s['id']}"


def number(sessions):
    """Numérote une liste triée de la plus ancienne à la plus récente (n°1 = la plus récente)
    et la mémorise, pour que « 3 » désigne une session dans les commandes suivantes."""
    nums = {s["id"]: len(sessions) - i for i, s in enumerate(sessions)}
    try:
        os.makedirs(os.path.dirname(LAST), exist_ok=True)
        with open(LAST, "w", encoding="utf-8") as fh:
            json.dump({str(n): sid for sid, n in nums.items()}, fh)
    except OSError:
        pass
    return nums


def header(s, home, n=None):
    proj = s["cwd"].replace(home, "~", 1)
    print(*([c("1;33", f"[{n}]")] if n else []), c("2", f"{s['end']:%Y-%m-%d %H:%M}"), c("36", s["id"][:8]), c("1", s["title"] or "(sans titre)"),
          c("35", proj), c("2", f"({len(s['prompts'])} prompts)"))


def snippet(text, kw, width=140):
    flat = " ".join(text.split())
    i = flat.lower().find(kw)
    start = max(0, i - width // 3)
    out = flat[start:start + width]
    j = out.lower().find(kw)
    out = out[:j] + c("1;31", out[j:j + len(kw)]) + out[j + len(kw):]
    return ("…" if start else "") + out + ("…" if start + width < len(flat) else "")


def search(sessions, words):
    kw = " ".join(words).lower()
    home = os.path.expanduser("~")
    hits = []
    for s in sessions:
        meta = " ".join([s["title"] or "", s["cwd"]]).lower()
        found = [("Toi", p) for p in s["prompts"] if kw in p.lower()] + \
                [("Claude", a) for a in s["replies"] if kw in a.lower()]
        if found or kw in meta:
            hits.append((s, found))
    hits.sort(key=lambda h: h[0]["end"])
    nums = number([s for s, _ in hits])
    for s, found in hits:
        header(s, home, nums[s["id"]])
        for who, text in found[:3]:
            print(f"    {c('33' if who == 'Toi' else '32', who + ' :')} {snippet(text, kw)}")
        if len(found) > 3:
            print(c("2", f"    … +{len(found) - 3} autre(s) occurrence(s)"))
        print("    " + c("1;34", "↻ " + resume_line(s)), "\n")
    print(c("2", f"{len(hits)} session(s) contiennent « {kw} » — relire : claudeHistory -s <n°|id>"
                 " · reprendre : claudeHistory resume <n°|id>"))


def conversation(s):
    """(heure, auteur, texte) pour chaque prompt et réponse visible de la session."""
    with open(s["file"], encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                d = json.loads(line)
            except Exception:
                continue
            when = ts(d["timestamp"]) if isinstance(d.get("timestamp"), str) else None
            hm = f"{when:%H:%M}" if when else "     "
            p = prompt_text(d)
            if p:
                yield hm, "Toi", p
            elif d.get("type") == "assistant" and not d.get("isSidechain"):
                a = assistant_text(d)
                if a:
                    yield hm, "Claude", a


def show(s, full):
    print(c("1;36", f"Session {s['id']}"), "—", c("1", s["title"] or "(sans titre)"))
    print(f"  Projet : {s['cwd']}" + (f"  [{s['branch']}]" if s["branch"] else ""))
    print(f"  Début  : {s['start']:%Y-%m-%d %H:%M}   Fin : {s['end']:%Y-%m-%d %H:%M}")
    print(f"  Reprendre : {resume_line(s)}\n")
    for hm, who, text in conversation(s):
        if who == "Toi":
            print(c("1;33", f"[{hm}] Toi :"), text, "\n")
        else:
            print(c("1;32", f"[{hm}] Claude :"), text if full else one_line(text, 300), "\n")


def find_session(sessions, prefix):
    """Session désignée par un début d'id, ou par son n° dans la dernière liste affichée (« 3 » ou « #3 »)."""
    ref = prefix.lstrip("#")
    if ref.isdigit() and len(ref) <= 4:
        try:
            with open(LAST, encoding="utf-8") as fh:
                prefix = json.load(fh)[str(int(ref))]
        except (OSError, ValueError, KeyError):
            sys.exit(f"Pas de session n°{ref} dans la dernière liste : relancer claudeHistory list ou search")
    hits = [s for s in sessions if s["id"].startswith(prefix)]
    if not hits:
        sys.exit(f"Aucune session ne commence par {prefix}")
    if len(hits) > 1:
        sys.exit("Plusieurs sessions correspondent : " + ", ".join(s["id"] for s in hits))
    return hits[0]


def delete_session(s):
    """Supprime le .jsonl de la session et le dossier de ses sous-agents."""
    os.remove(s["file"])
    if os.path.isdir(s["file"][:-6]):
        shutil.rmtree(s["file"][:-6])


def rename_session(s, title):
    """Ajoute une entrée custom-title, comme /rename dans Claude Code."""
    nl = False  # le fichier ne finit pas par un saut de ligne ?
    with open(s["file"], "rb") as fh:
        if fh.seek(0, os.SEEK_END):
            fh.seek(-1, os.SEEK_END)
            nl = fh.read(1) != b"\n"
    with open(s["file"], "a", encoding="utf-8", newline="\n") as fh:
        fh.write(("\n" if nl else "") + json.dumps(
            {"type": "custom-title", "customTitle": title, "sessionId": s["id"]}, ensure_ascii=False) + "\n")


def win_clipboard(text):
    """Presse-papiers Windows via l'API (clip.exe laisserait un BOM au début du texte)."""
    import ctypes
    from ctypes import wintypes
    k, u = ctypes.windll.kernel32, ctypes.windll.user32
    k.GlobalAlloc.restype, k.GlobalAlloc.argtypes = wintypes.HGLOBAL, [wintypes.UINT, ctypes.c_size_t]
    k.GlobalLock.restype, k.GlobalLock.argtypes = ctypes.c_void_p, [wintypes.HGLOBAL]
    k.GlobalUnlock.argtypes = [wintypes.HGLOBAL]
    u.SetClipboardData.restype, u.SetClipboardData.argtypes = wintypes.HANDLE, [wintypes.UINT, wintypes.HANDLE]
    data = (text + "\0").encode("utf-16-le")
    h = k.GlobalAlloc(0x0002, len(data))  # GMEM_MOVEABLE
    ctypes.memmove(k.GlobalLock(h), data, len(data))
    k.GlobalUnlock(h)
    if not u.OpenClipboard(None):
        return False
    try:
        u.EmptyClipboard()
        return bool(u.SetClipboardData(13, h))  # CF_UNICODETEXT
    finally:
        u.CloseClipboard()


def copy_to_clipboard(text):
    if WIN:
        return win_clipboard(text)
    cands, data = [["pbcopy"], ["wl-copy"], ["xclip", "-selection", "clipboard"], ["xsel", "-bi"]], text.encode()
    for cmd in cands:
        if shutil.which(cmd[0]):
            subprocess.run(cmd, input=data, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
    return False


def open_terminal(cwd, args):
    """Ouvre une nouvelle fenêtre de terminal dans cwd et y lance « claude <args> ».
    Retourne le nom du terminal utilisé, ou None si aucun n'est disponible."""
    cmd = " ".join(["claude"] + args)
    if WIN:
        ps = ["powershell", "-NoLogo", "-NoExit", "-Command", cmd]  # -NoExit : la fenêtre reste après claude
        if shutil.which("wt"):
            subprocess.Popen(["wt", "-w", "new", "-d", cwd] + ps)
            return "Windows Terminal"
        subprocess.Popen(ps, cwd=cwd, creationflags=subprocess.CREATE_NEW_CONSOLE)
        return "PowerShell"
    if sys.platform == "darwin":
        import shlex
        subprocess.Popen(["osascript", "-e", f'tell application "Terminal" to do script "cd {shlex.quote(cwd)} && {cmd}"',
                          "-e", 'tell application "Terminal" to activate'],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return "Terminal"
    for term, argv in (("gnome-terminal", ["gnome-terminal", f"--working-directory={cwd}", "--", "claude", *args]),
                       ("konsole", ["konsole", "--workdir", cwd, "-e", "claude", *args]),
                       ("x-terminal-emulator", ["x-terminal-emulator", "-e", "claude", *args])):
        if shutil.which(term):
            subprocess.Popen(argv, cwd=cwd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            return term
    return None


def open_folder(path):
    if WIN:
        os.startfile(path)
    else:
        subprocess.Popen(["open" if sys.platform == "darwin" else "xdg-open", path],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def encode_dir(cwd):
    """Nom du dossier projet tel que Claude Code le calcule à partir du cwd."""
    return re.sub(r"[^A-Za-z0-9]", "-", cwd)


def decode_dir(folder):
    """Inverse approximatif d'encode_dir (les « - » d'origine sont perdus), faute de cwd dans la session."""
    m = re.fullmatch(r"([A-Za-z])--(.*)", folder)
    if m:  # C--Users-moi-projet → C:\Users\moi\projet
        return m.group(1) + ":\\" + m.group(2).replace("-", "\\")
    return folder.replace("-", "/")


def export_history(sessions, dest=None):
    """Archive .tar.gz : manifest.json + projects/<dossier>/<id>.jsonl (+ sous-agents)."""
    import tarfile
    dest = dest or os.path.expanduser(f"~/claude-history-{datetime.now():%Y%m%d-%H%M%S}.tar.gz")
    manifest = {"home": os.path.expanduser("~"), "exported": datetime.now().astimezone().isoformat(),
                "sessions": []}
    with tarfile.open(dest, "w:gz", compresslevel=3) as tar:
        for s in sessions:
            folder = os.path.basename(os.path.dirname(s["file"]))
            tar.add(s["file"], f"projects/{folder}/{s['id']}.jsonl")
            if os.path.isdir(s["file"][:-6]):
                tar.add(s["file"][:-6], f"projects/{folder}/{s['id']}")
            manifest["sessions"].append({"id": s["id"], "cwd": s["cwd"], "folder": folder, "title": s["title"]})
        data = json.dumps(manifest, ensure_ascii=False, indent=2).encode()
        info = tarfile.TarInfo("manifest.json")
        info.size, info.mtime = len(data), int(datetime.now().timestamp())
        tar.addfile(info, io.BytesIO(data))
    return dest, len(sessions)


def import_history(src):
    """Restaure une archive dans ~/.claude/projects. Adapte les chemins si le $HOME diffère.
    Retourne (importées, ignorées car déjà présentes)."""
    import tarfile
    root = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"), "projects")
    home = os.path.expanduser("~")
    done = skipped = 0
    with tarfile.open(os.path.expanduser(src), "r:gz") as tar:
        manifest = json.load(tar.extractfile("manifest.json"))
        old_home = manifest.get("home") or home
        for m in manifest["sessions"]:
            sid, folder = m["id"], m["folder"]
            if not re.fullmatch(r"[0-9a-fA-F-]{8,}", sid) or re.search(r"[/\\:]", folder) \
                    or folder in ("", ".", ".."):
                continue
            cwd = m["cwd"]
            sep = "\\" if re.match(r"[A-Za-z]:\\", old_home) else "/"
            if old_home != home and (cwd == old_home or cwd.startswith(old_home + sep)):
                cwd = home + cwd[len(old_home):]
                folder = encode_dir(cwd)
            target = os.path.join(root, folder, sid + ".jsonl")
            if glob.glob(os.path.join(glob.escape(root), "*", glob.escape(sid) + ".jsonl")):
                skipped += 1
                continue
            os.makedirs(os.path.dirname(target), exist_ok=True)
            prefix = f"projects/{m['folder']}/{sid}"
            for member in tar.getmembers():
                if not (member.isfile() and (member.name == prefix + ".jsonl" or member.name.startswith(prefix + "/"))):
                    continue
                rel = member.name[len(f"projects/{m['folder']}/"):]
                if ".." in rel.split("/"):
                    continue
                data = tar.extractfile(member).read()
                if old_home != home and rel.endswith(".jsonl"):
                    old, new = json.dumps(old_home)[1:-1], json.dumps(home)[1:-1]
                    data = data.decode("utf-8", "replace").replace(f'"cwd":"{old}', f'"cwd":"{new}').encode()
                out = os.path.join(root, folder, rel)
                os.makedirs(os.path.dirname(out), exist_ok=True)
                with open(out, "wb") as fh:
                    fh.write(data)
            done += 1
    return done, skipped


def latest_export():
    found = glob.glob(os.path.expanduser("~/claude-history-*.tar.gz")) + \
            glob.glob(os.path.expanduser("~/T*l*chargements/claude-history-*.tar.gz")) + \
            glob.glob(os.path.expanduser("~/Downloads/claude-history-*.tar.gz"))
    return max(found, key=os.path.getmtime) if found else ""


def wrap(text, width):
    import textwrap
    out = []
    for para in text.splitlines() or [""]:
        out += textwrap.wrap(para, width) or [""]
    return out


